/* Override native GTK scrollbar colors for all web content.
 * Fixes the dark GTK trough painting near-black on hover under
 * Flat-Remix-GTK-Blue-Dark + prefer-dark. Explicit scrollbar-color
 * takes the GTK trough out of the equation, so hover can never
 * render black: track stays transparent, thumb is a neutral gray.
 * Thumb is deliberately bright/near-opaque with a faint tinted track
 * so the scrollbar reads clearly against dark page backgrounds. */
@-moz-document url-prefix("http") {
  * {
    scrollbar-color: rgba(190, 190, 190, 0.95) rgba(255, 255, 255, 0.08) !important;
    scrollbar-width: auto !important;
  }
}

async def test_process_message_low_confidence_holds_then_approve_places():
    conn = await _conn()
    ib, notes = FakeIB(), FakeNotifier()
    ex = Executor(conn, _config(), ib, notes,
                  interpret=_fixed_interpret(_interp(_buy_trade(), confidence=0.4)))

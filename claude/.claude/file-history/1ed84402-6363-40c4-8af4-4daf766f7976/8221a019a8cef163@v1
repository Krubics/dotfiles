async def test_process_message_dedupes_before_interpreting():
    conn = await _conn()
    ib, notes = FakeIB(), FakeNotifier()
    calls = {"n": 0}

    async def counting_interpret(**kwargs):
        calls["n"] += 1
        return _interp(_buy_trade(), confidence=0.95)

    ex = Executor(conn, _config(), ib, notes, interpret=counting_interpret)
    await ex.process_message(_inbound(1006))
    await ex.process_message(_inbound(1006))   # same id -> deduped before interpret
    assert calls["n"] == 1
    rows = [r for r in await ostore.list_orders(conn) if r["message_id"] == 1006]
    assert len(rows) == 1



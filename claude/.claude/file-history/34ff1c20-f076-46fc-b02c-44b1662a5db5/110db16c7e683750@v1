{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,

  "modules-left": [
     "image#clock",
     "custom/divider",
     "clock"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "custom/taskbar-divider",
    "hyprland/workspaces#taskbar",
  ],
  "modules-right": [
     "image#network",
     "network",
     "custom/divider",
     "image#bluetooth",
     "bluetooth",
     "custom/divider",
     "battery",
     "image#battery"
   ],

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "ignore-hidden": false,
    "on-click": "activate",
  },

  "custom/taskbar-divider": {
    "exec": "/home/krubics/.config/waybar/scripts/workspace-tabs.sh",
    "return-type": "json",
    "restart-interval": 0,
  },

  "custom/divider": {
     "format": "│"
  },

  "hyprland/workspaces#taskbar": {
    "format": "{windows}",
    "all-outputs": false,
    "active-only": true,
    "on-click": "activate",
    "workspace-taskbar": {
      "enable": true,
      "format": "{icon}",
      "icon-size": 20,
      "icon-theme": ["Papirus"],
      "orientation": "horizontal",
    },
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}",
  },

  "image#clock": {
    "path": "/home/krubics/.config/waybar/images/dialga.png",
    "size": 32,
  },

  "image#network": {
    "path": "/home/krubics/.config/waybar/images/pixelated-wooper.png",
    "size": 32,
  },

  "network": {
    "interface": "wlo1",
    "format": "{ifname}",
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "{ifname} ",
    "format-disconnected": "", //An empty format will hide the module.
    "format-disconnected": "",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },

  "image#bluetooth": {
    "path": "/home/krubics/.config/waybar/images/pixelated-magneton.png",
    "size": 32,
  },

  "battery": {
    "format": "{capacity}%",
  },

  "image#battery": {
    "exec": "/home/krubics/.config/waybar/scripts/pickachu-battery.sh",
    "size": 115,
    "interval": 30,
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": "{num_connections}C",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  },
}

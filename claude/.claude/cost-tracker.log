[2026-07-20T12:10:11.599Z] tool=Bash command=export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 cat > /tmp/mf.py <<'PY' from PIL import Image import sys im=Image.open(sys.argv[1]).convert('RGB'); px=im.load() sky=(126,190,240) def close(c,t,tol): return all(abs(c[i]-t[i])<=tol for i in range(3)) # pill = contiguous non-sky region near x=1280, using a mid row def notsky(x,y): return not close(px[x,y],sky,30) # find a good row: the one (in 6..52) giving widest non-sky run around 1280 def run_at(y):     # find run covering 1280     if close(px[1280,y],sky,30):         return None     l=1280     while l>1100 and notsky(l-1,y): l-=1     r=1280     while r<1460 and notsky(r+1,y): r+=1     return (l,r) best=None for y in range(6,52):     e=run_at(y)     if e and (best is None or (e[1]-e[0])>(best[1]-best[0])): best=e; besty=y ol,orr=best # inner edges: skip 2px border on each side il,ir=ol+2, orr-2 def ink(x):     for y in range(6,52):         r,g,b=px[x,y]         if (r>150 and g<130 and b<130) or (b>190 and g>170) or (r>190 and g>190 and b>190):             return True     return False cols=[x for x in range(il,ir+1) if ink(x)] print(f"outer pill=({ol},{orr}) inner=({il},{ir}) width={orr-ol}") print(f"first ink={min(cols)} last ink={max(cols)}") print(f"LEFT gap (inner->first ink)={min(cols)-il}px") print(f"RIGHT gap (last ink->inner)={ir-max(cols)}px") PY python3 /tmp/mf.py /tmp/wb_fix3.png echo "--- for comparison, pre-fix state (wb_test had workspaces-only; use original full: /tmp/waybar_full.png) ---" python3 /tmp/mf.py /tmp/waybar_full.png

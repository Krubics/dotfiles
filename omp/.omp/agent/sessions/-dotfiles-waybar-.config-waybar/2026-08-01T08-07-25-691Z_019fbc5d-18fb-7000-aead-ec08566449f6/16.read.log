        "url": "https://api.github.com/users/iamcheyan",
        "html_url": "https://github.com/iamcheyan",
        "followers_url": "https://api.github.com/users/iamcheyan/followers",
        "following_url": "https://api.github.com/users/iamcheyan/following{/other_user}",
        "gists_url": "https://api.github.com/users/iamcheyan/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/iamcheyan/starred{/owner}{/repo}",

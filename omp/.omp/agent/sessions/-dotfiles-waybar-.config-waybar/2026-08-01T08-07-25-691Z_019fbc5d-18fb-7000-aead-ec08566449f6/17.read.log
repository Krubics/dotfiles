    "user": {
      "login": "codevogel",
      "id": 8700780,
      "node_id": "MDQ6VXNlcjg3MDA3ODA=",
      "avatar_url": "https://avatars.githubusercontent.com/u/8700780?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/codevogel",
      "html_url": "https://github.com/codevogel",
      "followers_url": "https://api.github.com/users/codevogel/followers",
      "following_url": "https://api.github.com/users/codevogel/following{/other_user}",
      "gists_url": "https://api.github.com/users/codevogel/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/codevogel/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/codevogel/subscriptions",
      "organizations_url": "https://api.github.com/users/codevogel/orgs",
      "repos_url": "https://api.github.com/users/codevogel/repos",
      "events_url": "https://api.github.com/users/codevogel/events{/privacy}",
